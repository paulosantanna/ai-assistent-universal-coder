{
  "version": "2026.11.16",
  "reviewed_at": "2026-11-16T12:45:00Z",
  "aligned_upstream": "a5ad1714f00c9f7fde980cab0ea1d6dc6d414fd2",
  "upstream": "https://api.github.com/repos/semgrep/semgrep-rules/commits/develop",
  "rules": [
    {
      "id": "py-eval",
      "extensions": [
        ".py"
      ],
      "pattern": "(?<![\\w.])eval\\s*\\(",
      "message": "eval() executa texto como c\u00f3digo"
    },
    {
      "id": "py-exec",
      "extensions": [
        ".py"
      ],
      "pattern": "(?<![\\w.])exec\\s*\\(",
      "message": "exec() executa texto como c\u00f3digo"
    },
    {
      "id": "py-shell-true",
      "extensions": [
        ".py"
      ],
      "pattern": "shell\\s*=\\s*True",
      "message": "subprocess com shell=True"
    },
    {
      "id": "py-pickle-load",
      "extensions": [
        ".py"
      ],
      "pattern": "pickle\\.loads?\\s*\\(",
      "message": "pickle desserializa objetos arbitr\u00e1rios"
    },
    {
      "id": "py-yaml-unsafe",
      "extensions": [
        ".py"
      ],
      "pattern": "yaml\\.load\\s*\\(",
      "unless": [
        "SafeLoader",
        "BaseLoader",
        "CSafeLoader",
        "Loader="
      ],
      "message": "yaml.load sem Loader expl\u00edcito"
    },
    {
      "id": "py-verify-false",
      "extensions": [
        ".py"
      ],
      "pattern": "verify\\s*=\\s*False",
      "message": "verifica\u00e7\u00e3o TLS desligada"
    },
    {
      "id": "js-eval",
      "extensions": [
        ".js",
        ".mjs",
        ".cjs"
      ],
      "pattern": "(?<![\\w.$])eval\\s*\\(",
      "message": "eval() executa texto como c\u00f3digo"
    },
    {
      "id": "js-function-ctor",
      "extensions": [
        ".js",
        ".mjs",
        ".cjs"
      ],
      "pattern": "new\\s+Function\\s*\\(",
      "message": "new Function() executa texto como c\u00f3digo"
    }
  ]
}
