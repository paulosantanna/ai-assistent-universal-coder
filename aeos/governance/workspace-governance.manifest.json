{
  "standard": "CodENavi Full Workspace v2",
  "rootContract": "AGENT.md",
  "standardPath": "references/CODENAVI_FULL_WORKSPACE_STANDARD.md",
  "requiredLifecycle": "BRIEFING → RECON → PLAN → EXECUTE → VERIFY → DEBRIEF",
  "coveragePolicy": "all-tracked-files-governed-by-default",
  "governedRoots": ["."],
  "localContractRoots": [
    ".",
    ".agents",
    ".github",
    ".vscode",
    "AEOS_RUNTIME_MVP_v1",
    "aeos",
    "aeos/agents",
    "aeos/subagents",
    "aeos/skills",
    "aeos/playbooks",
    "aeos/mcps",
    "aeos/lcps",
    "aeos/registries",
    "aeos/blueprints",
    "aeos/config",
    "aeos/policies",
    "aeos/security",
    "aeos/capabilities",
    "aeos/network-capabilities",
    "aeos/connectors",
    "aeos/integrations",
    "aeos/runtime",
    "aeos/schemas",
    "aeos/evals",
    "aeos/knowledge",
    "aeos/knowledge-sources",
    "aeos/memory",
    "aeos/best-practices",
    "aeos/impact-analysis",
    "aura-voice-tool",
    "docs",
    "kinghost-commerce-mcp",
    "knowledge",
    "packages",
    "packages/aeos-language-server",
    "references",
    "runtime",
    "scripts",
    "skills",
    "templates",
    "tests"
  ],
  "artifactMatchers": {
    "agent": ["AGENT.md", "AGENTS.md", "_AGENT.md", "/agents/", "/subagents/", "agents.registry"],
    "skill": ["/skills/", "SKILL.md", ".skill.md", "skills.registry", "enterprise-skills.registry"],
    "playbook": ["/playbooks/", ".playbook.md", "playbooks.registry", "enterprise-playbooks.registry"],
    "mcp": ["/mcps/", ".mcp.yaml", "mcps.registry", "-mcp/"],
    "lcp": ["/lcps/", ".lcp.yaml", "lcps.registry"],
    "lsp": ["language-server", "/lsp/", "LSP"],
    "registry": ["/registries/", ".registry.yaml", "registry.index", "MANIFEST"],
    "blueprint": ["/blueprints/", "blueprints.registry", "architecture"],
    "eval": ["/evals/", "evaluation", "evaluator", "/tests/"],
    "memoryKnowledge": ["/memory/", "/knowledge/", ".notebook/", "MEMORY", "KNOWLEDGE"],
    "policyConfig": ["/config/", "/policies/", "/security/", "permissions", "allowlist", "denylist", "capabilities"],
    "runtimeTool": ["/runtime/", "-tool/", "tool-router", "executor", "adapter"],
    "ciRelease": [".github/workflows/", "pipeline", "deploy", "release"]
  },
  "ignoredPathPrefixes": [
    ".git/",
    "node_modules/",
    "dist/",
    "coverage/",
    ".tools/",
    "aeos/evidence/",
    "aeos/fixtures/"
  ]
}
