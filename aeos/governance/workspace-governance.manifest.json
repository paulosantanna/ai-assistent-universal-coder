    "registry": ["/registries/", ".registry.yaml", "registry.index"],
    "blueprint": ["/blueprints/", "blueprints.registry"],
    "eval": ["/evals/", "evaluation", "evaluator"],
    "memoryKnowledge": ["/memory/", "/knowledge/", ".notebook/", "MEMORY", "KNOWLEDGE"],
    "policyConfig": ["/config/", "policies", "permissions", "allowlist", "denylist"],
    "runtimeTool": ["/runtime/", "-tool/", "tool-router", "executor"],
    "ciRelease": [".github/workflows/", "pipeline", "deploy", "release"]
  },
  "ignoredPathPrefixes": [
    ".git/",
    "node_modules/",
    "dist/",
    "coverage/",
    ".tools/",
    "aeos/evidence/",
    "aeos/fixtures/"
