<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.aeos.telemetry</groupId>
    <artifactId>otel-telemetry-java-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>otel-telemetry-spring-boot-starter</artifactId>
  <name>otel-telemetry-spring-boot-starter</name>
  <description>Auto-configuração Spring Boot da telemetria a partir de properties oteltelemetry.*; inerte sem Spring (provided).</description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.aeos.telemetry</groupId>
      <artifactId>otel-telemetry-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aeos.telemetry</groupId>
      <artifactId>otel-telemetry-exporters</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- provided: apps sem Spring não recebem Spring por transição. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
