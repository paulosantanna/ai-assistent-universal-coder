{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeos.dev/skills/specs/output.schema.json",
  "title": "AEOS specs output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "revision",
    "status",
    "scope",
    "requirements",
    "acceptance_criteria",
    "design",
    "tasks",
    "test_matrix",
    "approval_gates",
    "evidence_gates",
    "blocking_conditions"
  ],
  "properties": {
    "spec_id": {"type": "string", "pattern": "^spec-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{8}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["PASS", "REVIEW", "BLOCKED"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "downstream_skill", "included", "excluded"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "downstream_skill": {"type": "string", "minLength": 1},
        "included": {"type": "array", "items": {"type": "string"}},
        "excluded": {"type": "array", "items": {"type": "string"}}
      }
    },
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
    "design": {
      "type": "object",
      "required": ["summary", "architecture_impact", "rollback", "observability"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "architecture_impact": {"type": "string", "minLength": 1},
        "rollback": {"type": "string", "minLength": 1},
        "observability": {"type": "string", "minLength": 1}
      }
    },
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
    "test_matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test_entry"}},
    "approval_gates": {"type": "array", "items": {"type": "string"}},
    "evidence_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "blocking_conditions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "statement", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^REQ-[0-9]{3}$"},
        "priority": {"enum": ["MUST", "SHOULD", "COULD"]},
        "statement": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement_ids", "statement", "verification"],
      "properties": {
        "id": {"type": "string", "pattern": "^AC-[0-9]{3}$"},
        "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^REQ-[0-9]{3}$"}},
        "statement": {"type": "string", "minLength": 1},
        "verification": {"enum": ["test", "inspection", "metric", "manual", "review"]}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "requirement_ids", "depends_on", "verification"],
      "properties": {
        "id": {"type": "string", "pattern": "^TASK-[0-9]{3}$"},
        "description": {"type": "string", "minLength": 1},
        "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^REQ-[0-9]{3}$"}},
        "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^TASK-[0-9]{3}$"}},
        "verification": {"type": "string", "minLength": 1}
      }
    },
    "test_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "disposition", "reason", "required_evidence"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["REQUIRED", "NOT_APPLICABLE", "DEFERRED_WITH_APPROVED_RISK"]},
        "reason": {"type": "string", "minLength": 1},
        "required_evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
